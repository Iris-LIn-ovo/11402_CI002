#include <iostream>
#include <vector>
#include <string>
#include <algorithm>

using namespace std;

class Solution {
public:
    string largestNumber(vector<int>& nums) {
        vector<string> strs;
        for (int num : nums) {
            strs.push_back(to_string(num));
        }

        // 自訂排序：比較 a+b 與 b+a
        sort(strs.begin(), strs.end(), [](const string& a, const string& b) {
            return a + b > b + a;
        });

        // 如果排序後第一個元素是 "0"，代表所有元素皆為 0
        if (strs[0] == "0") return "0";

        string result = "";
        for (const string& s : strs) {
            result += s;
        }

        return result;
    }
};
